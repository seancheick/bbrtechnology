# Canonical site URL. Leave unset on Vercel to use the production deployment URL;
# set it when the custom domain is attached, e.g. https://bbrtechnology.com
NEXT_PUBLIC_SITE_URL=

# Live demo (/api/demo). Server-only keys; never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DEMO_PROVIDER_ORDER=groq,gemini
DEMO_PROVIDER_TIMEOUT_MS=8000
GEMINI_TIMEOUT_MS=20000
DEMO_PER_MINUTE=5
DEMO_PER_DAY=30
DEMO_DAILY_CAP=300
DEMO_IP_SALT=change-me

# Durable rate limits (Upstash Redis free tier). Without these, limits are per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics (PostHog free tier, cookieless). Optional.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
